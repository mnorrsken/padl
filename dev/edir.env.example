# Settings for the eDirectory half of the lab.
#
# Copy this to dev/edir.env, which is gitignored, and fill in the two values
# that have no default. Nothing in this file may be committed: there is no
# public eDirectory image, and the one you have is licensed to you.
#
#   cp dev/edir.env.example dev/edir.env
#   $EDITOR dev/edir.env
#   make lab-profiles
#
# Without dev/edir.env the rest of the lab still comes up; eDirectory is simply
# left out, and `make lab-profiles` says so.

# The container image to configure a tree from. Required.
PADL_EDIR_IMAGE=

# The password for the tree administrator. eDirectory enforces complexity on it.
# Required.
PADL_EDIR_PASSWORD=

# Everything below has a default and is only worth setting if yours differs.

# Where the tree starts and who administers it, in LDAP form with commas.
# eDirectory publishes an empty namingContexts, so the base DN is not optional
# for PADL — it has nothing to discover.
#
# These two are also what the manual tests read, so sourcing this file is enough
# to run them:
#
#   set -a; . dev/edir.env; set +a; PADL_EDIR=1 go test ./internal/ldapx/ -run EDir -v
#
#PADL_EDIR_BASE_DN=o=padl
#PADL_EDIR_BIND_DN=cn=admin,o=padl

# The tree and server names ndsconfig is given.
#PADL_EDIR_TREE=PADLTREE
#PADL_EDIR_SERVER=edir1

# Host ports. 13391 and 13637 continue the lab's numbering.
#PADL_EDIR_LDAP_PORT=13391
#PADL_EDIR_LDAPS_PORT=13637
